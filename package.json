    "check:budgets": "node scripts/check-budgets.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.4.6",
    "@types/mdx": "^2.0.14",
    "github-slugger": "^2.0.0",
    "next": "16.4.6",
    "next-intl": "4.15.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-pretty-code": "0.14.6",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.6.0",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.187.0",
    "eslint": "^9",
